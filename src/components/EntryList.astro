---
import type { CollectionEntry } from 'astro:content';
import { evaluateAccess } from '../lib/access-control/policy';
import { entryWorld } from '../lib/universe';
interface Props { entries: CollectionEntry<'entries'>[]; heading?: string }
const { entries, heading = 'Found in the archive' } = Astro.props as Props;
const session = Astro.locals.session ?? null;
---
<section class="entry-section"><p class="label">{heading}</p><div class="entry-list">{await Promise.all(entries.map(async (entry) => { const access = await evaluateAccess({ path: `/entry/${entry.id}`, world: entryWorld(entry), visibility: entry.data.visibility, allowRequests: entry.data.allowRequests }, session); return <a href={`/entry/${entry.id}/`} class="entry-row"><span>{access.allowed ? 'open' : access.visibility === 'absolute_private' ? 'owner only' : 'private'}</span><h3>{entry.data.title}</h3><small>{access.allowed ? entry.data.type : 'Locked · sign in to request access'}</small><b>↗</b></a>; }))}</div></section>
