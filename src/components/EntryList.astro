---
import { niceDate } from '../lib/universe';
import type { CollectionEntry } from 'astro:content';
interface Props { entries: CollectionEntry<'entries'>[]; heading?: string }
const { entries, heading = 'Found in the archive' } = Astro.props as Props;
---
<section class="entry-section"><p class="label">{heading}</p><div class="entry-list">{entries.map((entry) => <a href={`/entry/${entry.id}/`} class="entry-row"><span>{entry.data.type}</span><h3>{entry.data.title}</h3><small>{entry.data.location ?? niceDate(entry.data.date)}</small><b>↗</b></a>)}</div></section>
