---
import '../styles/global.css';
import '../styles/archive.css';
import { getSessionFromCookies, isOwnerSession } from '../lib/access-control/auth';
const { title = "Raj's Corner" } = Astro.props;
const session = Astro.locals.session ?? getSessionFromCookies(Astro.request.headers.get('cookie'));
const isOwner = isOwnerSession(session);
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Raj's private archive." /><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" /></head><body><nav class="environmental-nav"><a class="signature" href="/">Raj <i>✦</i></a><div class="compass"><span class="compass-label">Index // </span><a href="/timeline/">Time</a><a href="/places/">Space</a><a href="/currently/">Present</a><a href="/rhythm/">Rhythm</a><a href="/archive/">Archive</a></div><div class="account-area">{session ? (<details><summary>{session.avatarUrl ? <img src={session.avatarUrl} alt="" referrerpolicy="no-referrer" /> : <span class="account-avatar">{session.name.slice(0, 1).toUpperCase()}</span>}<span>{session.name}</span></summary><div class="account-menu"><strong>{session.name}</strong><small>{session.email}</small>{isOwner && <a href="/admin/access">Access administration</a>}<a href="/login?switch=1">Switch account</a><form method="POST" action="/api/auth/logout"><input type="hidden" name="redirect" value={Astro.url.pathname} /><button type="submit">Sign out</button></form></div></details>) : <a href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`} class="account-signin">Sign in</a>}</div></nav><main><slot /></main><footer><span>Made slowly by Raj.</span><span>A private living archive.</span></footer><style>.environmental-nav{align-items:center}.account-area{margin-left:auto;font:11px var(--mono,monospace)}.account-area summary{display:flex;align-items:center;gap:7px;cursor:pointer;list-style:none}.account-area summary::-webkit-details-marker{display:none}.account-area img,.account-avatar{width:26px;height:26px;border-radius:50%;object-fit:cover;background:#222;color:#fff;display:grid;place-items:center}.account-menu{position:absolute;right:18px;top:50px;z-index:10;display:grid;gap:8px;min-width:190px;padding:12px;background:var(--bg,#fff);border:1px solid var(--line,#ddd);box-shadow:0 8px 25px #0002}.account-menu small{opacity:.7}.account-menu a,.account-menu button{font:inherit;color:inherit;text-decoration:none;background:none;border:0;padding:0;text-align:left;cursor:pointer}.account-signin{color:inherit;text-decoration:none}</style></body></html>
