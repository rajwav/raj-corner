---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { entries, placeSlug } from '../../lib/universe';

const snapshot = await getEntry('currently', 'now');
const items = Object.entries(snapshot!.data)
  .filter(([key, value]) => key !== 'updated' && key !== 'id' && value);

const sizeMap: Record<string, string> = {
  thinking: 'large',
  obsessed: 'large',
  building: 'large',
  reading: 'medium',
  learning: 'medium',
  planning: 'medium',
  listening: 'small',
  watching: 'small',
  wanting: 'small'
};

const updatedDate = snapshot!.data.updated.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' });

// Build a map of potential connections
const all = await entries();
const places = new Set(all.map(x=>x.data.location).filter(Boolean));

function linkify(text: any) {
  const str = String(text);
  // Match exact entry titles
  const matchingEntry = all.find(e => e.data.title.toLowerCase() === str.toLowerCase());
  if (matchingEntry) return `<a href="/entry/${matchingEntry.id}/" class="currently-link">${str}</a>`;
  
  // Match music entries specifically within text (e.g. "Ruposh by AVOIDRPH")
  const musicEntries = all.filter(e => e.data.type === 'music');
  for (const m of musicEntries) {
    if (!m.data.title) continue;
    const escaped = m.data.title.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(^|\\b)(${escaped})(\\b|$)`, 'i');
    if (regex.test(str)) {
      return str.replace(regex, `$1<a href="/entry/${m.id}/" class="currently-link">$2</a>$3`);
    }
  }

  // Match places
  const matchingPlace = [...places].find(p => String(p).toLowerCase() === str.toLowerCase());
  if (matchingPlace) return `<a href="/places/${placeSlug(String(matchingPlace))}/" class="currently-link">${str}</a>`;
  
  return str;
}
---

<Base title="Currently · Raj's Corner">
  <article class="currently-container">
    <header class="currently-header">
      <span class="currently-label">Now</span>
      <h1 class="currently-title">Things occupying my head lately.</h1>
      <div class="currently-meta">
        <span class="currently-status">Temporary snapshot</span>
        <span class="currently-date">Recorded: {updatedDate}</span>
      </div>
    </header>

    <section class="currently-scatter">
      {items.map(([label, value]) => {
        const sizeClass = sizeMap[label] || 'medium';
        return (
          <div class={`currently-note note-${sizeClass} note-${label}`}>
            <span class="note-label">{label}</span>
            <div class="note-content" set:html={linkify(value)} />
          </div>
        );
      })}
    </section>
  </article>
</Base>
