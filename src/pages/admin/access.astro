---
import Base from '../../layouts/Base.astro';
import { getSessionFromCookies, isOwnerSession } from '../../lib/access-control/auth';
import { getStorage } from '../../lib/access-control/storage';
import type { AccessGrant, AccessRequest } from '../../lib/access-control/types';

export const prerender = false;

const session = getSessionFromCookies(Astro.request.headers.get('cookie'));
if (!isOwnerSession(session)) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const storage = getStorage();
const allRequests = await storage.getRequests();
const pendingRequests = allRequests.filter(r => r.status === 'pending');

const allGrants = await storage.getGrants();
const activeGrants = allGrants.filter(g => g.status === 'active');
const revokedGrants = allGrants.filter(g => g.status === 'revoked');

const visibilityOverrides = await storage.getVisibilityOverrides();

// Aggregated Unique Users
const userMap = new Map<string, {
  email: string;
  name: string;
  grants: AccessGrant[];
  requests: AccessRequest[];
}>();

for (const g of allGrants) {
  const email = g.userEmail.toLowerCase().trim();
  if (!userMap.has(email)) {
    userMap.set(email, {
      email,
      name: g.userName || email.split('@')[0],
      grants: [],
      requests: [],
    });
  }
  userMap.get(email)!.grants.push(g);
}

for (const r of allRequests) {
  const email = r.userEmail.toLowerCase().trim();
  if (!userMap.has(email)) {
    userMap.set(email, {
      email,
      name: r.userName || email.split('@')[0],
      grants: [],
      requests: [],
    });
  }
  userMap.get(email)!.requests.push(r);
}

const allUsers = Array.from(userMap.values());

const urlParams = Astro.url.searchParams;
const statusFilter = urlParams.get('status') || 'all';
const scopeFilter = urlParams.get('scope') || 'all';
const searchQuery = (urlParams.get('q') || '').toLowerCase().trim();

const filteredGrants = allGrants.filter(g => {
  const matchesStatus = statusFilter === 'all' || g.status === statusFilter;
  const matchesScope = scopeFilter === 'all' || g.scope === scopeFilter;
  const matchesSearch = !searchQuery || 
    g.userEmail.toLowerCase().includes(searchQuery) ||
    (g.userName && g.userName.toLowerCase().includes(searchQuery)) ||
    g.target.toLowerCase().includes(searchQuery);
  return matchesStatus && matchesScope && matchesSearch;
});

const approvedMsg = urlParams.get('approved');
const rejectedMsg = urlParams.get('rejected');
const revokedMsg = urlParams.get('revoked');
const restoredMsg = urlParams.get('restored');
const updatedMsg = urlParams.get('updated');
const grantedMsg = urlParams.get('granted');
const isDurable = storage.isDurable();
const backendType = storage.getBackendType();
const isServerlessWithoutDurable = !isDurable && (Boolean(process.env.VERCEL) || Astro.url.hostname.includes('vercel.app'));
---


<Base title="Access Management & Permissions · Raj's Corner">
  <div class="admin-wrapper">
    <header class="admin-header">
      <div class="admin-header-lead">
        <span class="admin-badge">✦ Owner Administration</span>
        <h1 class="admin-title">Access Perimeter & Permissions</h1>
        <p class="admin-desc">Owner control center for permissions, readers, security policies, and access requests.</p>
      </div>

      <div class="admin-quick-stats">
        <div class="stat-box">
          <span class="stat-number">{allUsers.length}</span>
          <span class="stat-label">Total Users</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{activeGrants.length}</span>
          <span class="stat-label">Active Grants</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{pendingRequests.length}</span>
          <span class="stat-label">Pending Req</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{revokedGrants.length}</span>
          <span class="stat-label">Revoked</span>
        </div>
        <div class="stat-box">
          <span class="stat-number" style={isDurable ? 'color:#059669;' : 'color:#d97706;'}>
            {isDurable ? 'Durable' : 'Local'}
          </span>
          <span class="stat-label">{backendType.toUpperCase()} STORE</span>
        </div>
      </div>
    </header>

    {isServerlessWithoutDurable && (
      <div class="admin-banner warning">
        ⚠️ <strong>Notice on Production Durability:</strong>
        No managed cloud database (Upstash Redis / Vercel KV) is connected yet.
        On Vercel serverless, runtime modifications cannot be shared across separate instances or survive cold starts until you connect an Upstash Redis database.
        <div style="margin-top:0.4rem; font-size:0.82rem;">
          Required Vercel Environment Variables: <code>KV_REST_API_URL</code> & <code>KV_REST_API_TOKEN</code> (or <code>UPSTASH_REDIS_REST_URL</code> & <code>UPSTASH_REDIS_REST_TOKEN</code>).
        </div>
      </div>
    )}

    <!-- Feedback Banners -->

    {approvedMsg && <div class="admin-banner success">✓ Approved access for {approvedMsg}</div>}
    {rejectedMsg && <div class="admin-banner danger">✕ Rejected request from {rejectedMsg}</div>}
    {revokedMsg && <div class="admin-banner info">● Access permission revoked successfully.</div>}
    {restoredMsg && <div class="admin-banner success">✓ Access permission restored to active status.</div>}
    {updatedMsg && <div class="admin-banner success">✓ Permission settings updated successfully.</div>}
    {grantedMsg && <div class="admin-banner success">✓ Direct grant created for {grantedMsg}</div>}

    <main class="admin-grid">
      <!-- ─── 1. PENDING REQUESTS ─────────────────────────────────────────── -->
      <section class="admin-section requests-section">
        <div class="section-title-row">
          <h2 class="section-title">Pending Access Requests</h2>
          <span class="section-count">{pendingRequests.length}</span>
        </div>

        {pendingRequests.length === 0 ? (
          <p class="admin-empty">No pending requests right now. Your archive perimeter is quiet.</p>
        ) : (
          <div class="requests-list">
            {pendingRequests.map(req => (
              <article class="request-card">
                <div class="req-header">
                  <div>
                    <h3 class="req-name">{req.userName}</h3>
                    <span class="req-email">{req.userEmail}</span>
                  </div>
                  <span class="req-date">{new Date(req.createdAt).toLocaleDateString('en', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                </div>

                <div class="req-target">
                  <span class="req-target-label">Requested:</span>
                  <code class="req-target-path">{req.resourcePath}</code>
                  <span class="req-scope-badge">Scope: {req.requestedScope.toUpperCase()}</span>
                </div>

                {req.note && (
                  <blockquote class="req-note">"{req.note}"</blockquote>
                )}

                <div class="req-actions">
                  <!-- Approve Page -->
                  <form method="POST" action="/api/access/manage" class="inline-form">
                    <input type="hidden" name="action" value="approve" />
                    <input type="hidden" name="requestId" value={req.id} />
                    <input type="hidden" name="scope" value="page" />
                    <button type="submit" class="btn-approve">Approve (This Page)</button>
                  </form>

                  <!-- Approve World -->
                  {req.worldSlug && (
                    <form method="POST" action="/api/access/manage" class="inline-form">
                      <input type="hidden" name="action" value="approve" />
                      <input type="hidden" name="requestId" value={req.id} />
                      <input type="hidden" name="scope" value="world" />
                      <button type="submit" class="btn-approve-secondary">Approve World ({req.worldSlug})</button>
                    </form>
                  )}

                  <!-- Approve Site -->
                  <form method="POST" action="/api/access/manage" class="inline-form">
                    <input type="hidden" name="action" value="approve" />
                    <input type="hidden" name="requestId" value={req.id} />
                    <input type="hidden" name="scope" value="site" />
                    <button type="submit" class="btn-approve-secondary">Approve Entire Site</button>
                  </form>

                  <!-- Reject -->
                  <form method="POST" action="/api/access/manage" class="inline-form">
                    <input type="hidden" name="action" value="reject" />
                    <input type="hidden" name="requestId" value={req.id} />
                    <button type="submit" class="btn-reject">Reject</button>
                  </form>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <!-- ─── 2. ACTIVE & REVOKED PERMISSIONS (MANAGEMENT) ────────────────── -->
      <section class="admin-section grants-section">
        <div class="section-title-row">
          <div class="title-with-actions">
            <h2 class="section-title">Permissions & Reader Grants</h2>
            <a href="/api/access/manage?export=json" download class="btn-export">⇣ Export Store (.json)</a>
          </div>
          <span class="section-count">{filteredGrants.length}</span>
        </div>

        <!-- Filter & Search Toolbar -->
        <form method="GET" class="filter-toolbar">
          <div class="filter-field search-field">
            <input 
              type="search" 
              name="q" 
              placeholder="Search reader email, name, or resource path..." 
              value={urlParams.get('q') || ''} 
              class="search-input"
            />
          </div>
          <div class="filter-controls">
            <label class="filter-select-label">
              <span>Status</span>
              <select name="status" onchange="this.form.submit()">
                <option value="all" selected={statusFilter === 'all'}>All Statuses</option>
                <option value="active" selected={statusFilter === 'active'}>Active</option>
                <option value="revoked" selected={statusFilter === 'revoked'}>Revoked</option>
              </select>
            </label>
            <label class="filter-select-label">
              <span>Scope</span>
              <select name="scope" onchange="this.form.submit()">
                <option value="all" selected={scopeFilter === 'all'}>All Scopes</option>
                <option value="page" selected={scopeFilter === 'page'}>Page Only</option>
                <option value="world" selected={scopeFilter === 'world'}>World</option>
                <option value="site" selected={scopeFilter === 'site'}>Entire Site</option>
              </select>
            </label>
            <button type="submit" class="btn-filter">Filter</button>
            {(statusFilter !== 'all' || scopeFilter !== 'all' || searchQuery) && (
              <a href="/admin/access" class="btn-reset">Reset</a>
            )}
          </div>
        </form>

        {filteredGrants.length === 0 ? (
          <p class="admin-empty">No permissions match the current filters.</p>
        ) : (
          <div class="grants-table-wrapper">
            <table class="grants-table">
              <thead>
                <tr>
                  <th>Reader</th>
                  <th>Scope</th>
                  <th>Target Resource</th>
                  <th>Status</th>
                  <th>Granted At / By</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {filteredGrants.map(grant => (
                  <tr class={`grant-row status-${grant.status}`}>
                    <td>
                      <strong class="reader-name">{grant.userName || grant.userEmail.split('@')[0]}</strong>
                      <span class="table-sub">{grant.userEmail}</span>
                    </td>
                    <td>
                      <span class={`scope-pill scope-${grant.scope}`}>{grant.scope.toUpperCase()}</span>
                    </td>
                    <td>
                      <code class="grant-target">{grant.target}</code>
                    </td>
                    <td>
                      <span class={`status-badge status-${grant.status}`}>
                        {grant.status === 'active' ? '● Active' : '✕ Revoked'}
                      </span>
                    </td>
                    <td class="table-date">
                      <div>{new Date(grant.grantedAt).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                      <span class="table-sub">by {grant.grantedBy}</span>
                      {grant.status === 'revoked' && grant.revokedAt && (
                        <div class="revoked-info">
                          Revoked {new Date(grant.revokedAt).toLocaleDateString('en', { month: 'short', day: 'numeric' })}
                          {grant.revokedBy && <span> by {grant.revokedBy}</span>}
                        </div>
                      )}
                    </td>
                    <td class="actions-cell">
                      <div class="action-buttons">
                        <!-- Edit Button -->
                        <button 
                          type="button" 
                          class="btn-action btn-edit" 
                          data-grant-id={grant.id}
                          data-email={grant.userEmail}
                          data-name={grant.userName || ''}
                          data-scope={grant.scope}
                          data-target={grant.target}
                        >
                          Edit
                        </button>

                        {grant.status === 'active' ? (
                          <button 
                            type="button" 
                            class="btn-action btn-revoke"
                            data-grant-id={grant.id}
                            data-email={grant.userEmail}
                            data-target={grant.target}
                          >
                            Revoke
                          </button>
                        ) : (
                          <form method="POST" action="/api/access/manage" class="inline-form">
                            <input type="hidden" name="action" value="restore" />
                            <input type="hidden" name="grantId" value={grant.id} />
                            <button type="submit" class="btn-action btn-restore">Restore</button>
                          </form>
                        )}

                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <!-- ─── 3. DIRECT GRANT (MANUAL INVITE) ─────────────────────────────── -->
      <section class="admin-section manual-section">
        <h2 class="section-title">Directly Grant Access</h2>
        <p class="section-desc">Authorize a friend, family member, or reader directly by email with custom scope and target.</p>

        <form method="POST" action="/api/access/manage" class="direct-grant-form">
          <input type="hidden" name="action" value="grant_direct" />

          <div class="form-row">
            <label>
              <span>Reader Email</span>
              <input type="email" name="email" required placeholder="reader@example.com" />
            </label>
            <label>
              <span>Reader Name (optional)</span>
              <input type="text" name="name" placeholder="e.g. Maya" />
            </label>
          </div>

          <div class="form-row">
            <label>
              <span>Scope</span>
              <select name="scope" id="direct-scope-select">
                <option value="page">Specific Page (/entry/...)</option>
                <option value="world">World Collection</option>
                <option value="site">Entire Site (*)</option>
              </select>
            </label>
            <label>
              <span>Target Resource</span>
              <input type="text" name="target" id="direct-target-input" value="/entry/" required placeholder="/entry/slug or world name or *" />
            </label>
          </div>

          <button type="submit" class="btn-primary">Grant Permission</button>
        </form>
      </section>

      <!-- ─── 4. AUDIT TRAIL & REQUEST HISTORY ────────────────────────────── -->
      <section class="admin-section request-history-section">
        <div class="section-title-row">
          <h2 class="section-title">Audit Log & Request History</h2>
          <span class="section-count">{allRequests.length}</span>
        </div>

        {allRequests.length === 0 ? (
          <p class="admin-empty">No access requests recorded.</p>
        ) : (
          <div class="grants-table-wrapper">
            <table class="grants-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Requested Scope / Target</th>
                  <th>Status</th>
                  <th>Requested</th>
                  <th>Reviewed By / At</th>
                </tr>
              </thead>
              <tbody>
                {allRequests.map(req => (
                  <tr>
                    <td>
                      <strong>{req.userName}</strong>
                      <span class="table-sub">{req.userEmail}</span>
                    </td>
                    <td>
                      <span class="scope-pill">{req.requestedScope.toUpperCase()}</span>
                      <code>{req.requestedScope === 'world' ? req.worldSlug : req.requestedScope === 'site' ? '*' : req.resourcePath}</code>
                    </td>
                    <td>
                      <span class={`status-badge status-${req.status}`}>{req.status}</span>
                    </td>
                    <td class="table-date">{new Date(req.createdAt).toLocaleString()}</td>
                    <td class="table-date">
                      {req.reviewedAt ? (
                        <div>
                          <div>{new Date(req.reviewedAt).toLocaleString()}</div>
                          <span class="table-sub">by {req.reviewedBy || 'owner'}</span>
                        </div>
                      ) : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <!-- ─── 5. MAJOR SECTION VISIBILITY OVERRIDES ────────────────────────── -->
      <section class="admin-section visibility-section">
        <h2 class="section-title">Major Page Visibility Overrides</h2>
        <p class="section-desc">Override baseline visibility of top-level worlds, sections, or individual entries.</p>

        <form method="POST" action="/api/access/manage" class="direct-grant-form" style="margin-bottom:1.5rem">
          <input type="hidden" name="action" value="set_visibility" />
          <div class="form-row">
            <label>
              <span>Exact Path</span>
              <input type="text" name="path" required placeholder="/ (whole site), /world/life, /entry/slug" />
            </label>
            <label>
              <span>Visibility</span>
              <select name="visibility">
                <option value="private">Private (Requestable)</option>
                <option value="absolute_private">Absolute Private (No Requests)</option>
                <option value="public">Public</option>
              </select>
            </label>
          </div>
          <button type="submit" class="btn-primary">Save Visibility Policy</button>
        </form>

        <div class="visibility-items">
          {[
            { label: 'Whole Website', path: '/' },
            { label: 'The Archive', path: '/archive' },
            { label: 'Timeline', path: '/timeline' },
            { label: 'Atlas / Places', path: '/places' },
            { label: 'Rhythm (Habits)', path: '/rhythm' },
            { label: 'Currently (Now)', path: '/currently' },
            { label: 'Travel World', path: '/world/travel' },
            { label: 'Life World', path: '/world/life' },
            { label: 'Interests World', path: '/world/interests' },
            { label: 'Making World', path: '/world/making' },
          ].map(item => {
            const override = visibilityOverrides.find(o => o.path === item.path);
            const currentVis = override ? override.visibility : 'private';
            return (
              <form method="POST" action="/api/access/manage" class="visibility-row">
                <input type="hidden" name="action" value="set_visibility" />
                <input type="hidden" name="path" value={item.path} />
                <div class="vis-info">
                  <strong>{item.label}</strong>
                  <code>{item.path}</code>
                </div>
                <div class="vis-controls">
                  <select name="visibility">
                    <option value="public" selected={currentVis === 'public'}>Public</option>
                    <option value="private" selected={currentVis === 'private'}>Private (Requestable)</option>
                    <option value="absolute_private" selected={currentVis === 'absolute_private'}>Absolute Private</option>
                  </select>
                  <button type="submit" class="btn-save-sm">Save</button>
                </div>
              </form>
            );
          })}
        </div>
      </section>
    </main>

    <!-- ─── CONFIRM REVOCATION DIALOG ────────────────────────────────────── -->
    <dialog id="revoke-dialog" class="admin-modal">
      <form method="POST" action="/api/access/manage" class="modal-card">
        <input type="hidden" name="action" value="revoke" />
        <input type="hidden" name="grantId" id="revoke-grant-id" />

        <h3 class="modal-title">Confirm Access Revocation</h3>
        <p class="modal-desc">
          Are you sure you want to revoke access for <strong id="revoke-user-email"></strong> to <code id="revoke-target-path"></code>?
        </p>
        <p class="modal-sub">
          The reader will immediately lose access to private fragments and protected media for this target. You can restore access at any time from this dashboard.
        </p>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="cancel-revoke-btn">Cancel</button>
          <button type="submit" class="btn-danger-confirm">Confirm Revocation</button>
        </div>
      </form>
    </dialog>

    <!-- ─── EDIT GRANT DIALOG ────────────────────────────────────────────── -->
    <dialog id="edit-dialog" class="admin-modal">
      <form method="POST" action="/api/access/manage" class="modal-card">
        <input type="hidden" name="action" value="edit_grant" />
        <input type="hidden" name="grantId" id="edit-grant-id" />

        <h3 class="modal-title">Edit Permission Scope & Target</h3>
        <p class="modal-desc">
          Modifying permission for <strong id="edit-user-email"></strong>.
        </p>

        <div class="form-row" style="margin: 1.2rem 0;">
          <label>
            <span>Scope</span>
            <select name="scope" id="edit-scope-select">
              <option value="page">Specific Page</option>
              <option value="world">World Collection</option>
              <option value="site">Entire Site (*)</option>
            </select>
          </label>
          <label>
            <span>Target Resource</span>
            <input type="text" name="target" id="edit-target-input" required />
          </label>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="cancel-edit-btn">Cancel</button>
          <button type="submit" class="btn-primary">Save Changes</button>
        </div>
      </form>
    </dialog>

    <footer class="admin-footer">
      <a href="/" class="admin-back">← Return to Raj's Corner</a>
      <form method="POST" action="/api/auth/logout" style="display:inline;">
        <button type="submit" class="admin-logout">Log Out of Admin</button>
      </form>
    </footer>
  </div>
</Base>

<script>
  // Target sync for Direct Grant Form
  const directScope = document.getElementById('direct-scope-select') as HTMLSelectElement | null;
  const directTarget = document.getElementById('direct-target-input') as HTMLInputElement | null;
  if (directScope && directTarget) {
    directScope.addEventListener('change', () => {
      if (directScope.value === 'site') directTarget.value = '*';
      else if (directScope.value === 'world') directTarget.value = 'life';
      else directTarget.value = '/entry/';
    });
  }

  // Revocation Modal Logic
  const revokeDialog = document.getElementById('revoke-dialog') as HTMLDialogElement | null;
  const revokeGrantId = document.getElementById('revoke-grant-id') as HTMLInputElement | null;
  const revokeEmail = document.getElementById('revoke-user-email');
  const revokeTarget = document.getElementById('revoke-target-path');
  const cancelRevokeBtn = document.getElementById('cancel-revoke-btn');

  document.querySelectorAll('.btn-revoke').forEach(button => {
    button.addEventListener('click', () => {
      const b = button as HTMLElement;
      if (revokeDialog && revokeGrantId && revokeEmail && revokeTarget) {
        revokeGrantId.value = b.dataset.grantId || '';
        revokeEmail.textContent = b.dataset.email || 'this reader';
        revokeTarget.textContent = b.dataset.target || 'target';
        revokeDialog.showModal();
      }
    });
  });

  if (cancelRevokeBtn && revokeDialog) {
    cancelRevokeBtn.addEventListener('click', () => revokeDialog.close());
  }

  // Edit Modal Logic
  const editDialog = document.getElementById('edit-dialog') as HTMLDialogElement | null;
  const editGrantId = document.getElementById('edit-grant-id') as HTMLInputElement | null;
  const editEmail = document.getElementById('edit-user-email');
  const editScope = document.getElementById('edit-scope-select') as HTMLSelectElement | null;
  const editTarget = document.getElementById('edit-target-input') as HTMLInputElement | null;
  const cancelEditBtn = document.getElementById('cancel-edit-btn');

  document.querySelectorAll('.btn-edit').forEach(button => {
    button.addEventListener('click', () => {
      const b = button as HTMLElement;
      if (editDialog && editGrantId && editEmail && editScope && editTarget) {
        editGrantId.value = b.dataset.grantId || '';
        editEmail.textContent = b.dataset.email || 'this reader';
        editScope.value = b.dataset.scope || 'page';
        editTarget.value = b.dataset.target || '';
        editDialog.showModal();
      }
    });
  });

  if (editScope && editTarget) {
    editScope.addEventListener('change', () => {
      if (editScope.value === 'site') editTarget.value = '*';
      else if (editScope.value === 'world' && editTarget.value.startsWith('/entry/')) editTarget.value = 'life';
      else if (editScope.value === 'page' && !editTarget.value.startsWith('/')) editTarget.value = '/entry/';
    });
  }

  if (cancelEditBtn && editDialog) {
    cancelEditBtn.addEventListener('click', () => editDialog.close());
  }
</script>

<style>
  .admin-wrapper {
    max-width: 1040px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    font-family: var(--sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    color: var(--ink, #1f1e1c);
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
