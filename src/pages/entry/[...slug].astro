---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { niceDate, placeSlug, worldForType } from '../../lib/universe';
import { parseMentionsInText } from '../../lib/mentions';
import { renderEntryHeader, renderEntryCover, renderEntryTags, renderPersonTraces, renderContinuation, getPresentationClasses } from '../../lib/entryTemplate.js';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection('entries')).sort((a,b) => Number(b.data.date ?? 0) - Number(a.data.date ?? 0));

// Compute relationships
const related = all.filter(x => entry.data.related.includes(x.id));
const connectedFrom = all.filter(x => x.data.related.includes(entry.id) && x.id !== entry.id);
const samePlace = entry.data.location ? all.filter(x => x.data.location === entry.data.location && x.id !== entry.id) : [];
const sameTags = entry.data.tags.length > 0 ? all.filter(x => x.id !== entry.id && x.data.tags.some(t => entry.data.tags.includes(t))) : [];

const rawMentions = await parseMentionsInText(entry.body || '');
const resolvedMentions = rawMentions.filter(m => m.type !== 'unknown');

const titleMentionStr = `@${entry.data.title}`;
const idMentionStr = `@${entry.id}`;
const mentionedBy = all.filter(x => x.id !== entry.id && 
  ((x.body || '').toLowerCase().includes(titleMentionStr.toLowerCase()) || (x.body || '').toLowerCase().includes(idMentionStr.toLowerCase()))
);

// Timeline Neighbors
const timelineIndex = all.findIndex(x => x.id === entry.id);
const timelineNeighbors = [];
if (timelineIndex > 0) timelineNeighbors.push(all[timelineIndex - 1]);
if (timelineIndex < all.length - 1 && timelineIndex !== -1) timelineNeighbors.push(all[timelineIndex + 1]);

// Curation Logic
const threads: {url: string, title: string, typeLabel: string}[] = [];
const seenUrls = new Set();
function addThread(url: string, title: string, typeLabel: string) {
  if (seenUrls.has(url)) return;
  seenUrls.add(url);
  threads.push({ url, title, typeLabel });
}

// 1. Explicit
for (const item of related) addThread(`/entry/${item.id}/`, item.data.title, 'Explicitly linked');
for (const item of connectedFrom) addThread(`/entry/${item.id}/`, item.data.title, 'Referenced by');

// 2. Mentions
for (const m of resolvedMentions) { if (m.url && m.name) addThread(m.url, m.name, m.type === 'place' ? 'Mentioned location' : 'Mentioned entity'); }
for (const m of mentionedBy) addThread(`/entry/${m.id}/`, m.data.title, 'Mentioned in');

// 3. Place
if (entry.data.location) {
  addThread(`/places/${placeSlug(entry.data.location)}/`, entry.data.location, 'Location');
}

// 4. Same place
for (const item of samePlace.slice(0, 2)) addThread(`/entry/${item.id}/`, item.data.title, 'Same place');

// 5. Same tag
for (const item of sameTags.slice(0, 2)) addThread(`/entry/${item.id}/`, item.data.title, 'Related thread');

// 6. Timeline neighbor
if (threads.length < 5) {
  for (const item of timelineNeighbors) addThread(`/entry/${item.id}/`, item.data.title, 'Adjacent in time');
}

const curatedThreads = threads.slice(0, 5);

// Person Traces
const personTraces: typeof all = [];
if (entry.data.type === 'person') {
  const seenTraces = new Set();
  const addTrace = (item: any) => {
    if (seenTraces.has(item.id)) return;
    seenTraces.add(item.id);
    personTraces.push(item);
  };

  // 1. Mentions
  for (const m of mentionedBy) addTrace(m);

  // 2. PEOPLE field
  for (const x of all) {
    if (x.id !== entry.id && (x.data.people || []).some(p => p.toLowerCase() === entry.data.title.toLowerCase() || p.toLowerCase() === entry.id.toLowerCase() || p.toLowerCase().replace(/ /g, '-') === entry.id.toLowerCase())) {
      addTrace(x);
    }
  }

  // 3. Related Entries
  for (const x of connectedFrom) addTrace(x);

  personTraces.sort((a, b) => {
    if (a.data.date && b.data.date) return Number(b.data.date) - Number(a.data.date);
    if (a.data.date) return -1;
    if (b.data.date) return 1;
    return a.data.title.localeCompare(b.data.title);
  });
}

---
<Base title={`${entry.data.title} · Raj's Corner`}>
    <article class={`artifact-page ${entry.data.accent} ${entry.data.type === 'person' ? 'person-artifact' : ''} ${getPresentationClasses(entry.data.presentation)}`}>
    <div set:html={renderEntryHeader(entry.data, entry.data.type === 'person', niceDate(entry.data.date), placeSlug(entry.data.location || ''), worldForType(entry.data.type))} />
    <div set:html={renderEntryCover(entry.data, entry.data.type === 'person', niceDate(entry.data.date))} />

    <div class={`artifact-body ${entry.data.type === 'person' ? 'person-body' : ''}`}>
      <div class="prose"><Content /></div>
      <div set:html={renderEntryTags(entry.data.tags)} />
    </div>
    
    <div set:html={renderPersonTraces(personTraces, niceDate)} />
  </article>

<div set:html={renderContinuation(curatedThreads)} />

<script>
  // Promote markdown image titles to figcaptions in the preview
  document.querySelectorAll('.prose img').forEach((el) => {
    const img = el; // let JS duck-typing handle it in browser, but we'll use getAttribute for TS
    if (!img.closest('figure')) {
      const src = img.getAttribute('src');
      const title = img.getAttribute('title');
      if (!title && !(src && src.includes('#'))) return;
      
      const fig = document.createElement('figure');
      fig.className = 'story-image-figure';
      
      if (src && src.includes('#')) {
        const hash = src.split('#')[1];
        const params = new URLSearchParams(hash);
        if (params.get('s')) fig.classList.add('s-' + params.get('s'));
        if (params.get('a')) fig.classList.add('a-' + params.get('a'));
        if (params.get('t')) fig.classList.add('t-' + params.get('t'));
      }
      
      if (img.parentNode) {
        img.parentNode.insertBefore(fig, img);
        fig.appendChild(img);
        if (title) {
          const cap = document.createElement('figcaption');
          cap.textContent = title;
          fig.appendChild(cap);
        }
      }
    }
  });
</script>

</Base>
