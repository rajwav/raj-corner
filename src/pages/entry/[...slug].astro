---
import { getCollection, render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import { niceDate, placeSlug, worldForType } from '../../lib/universe';
export async function getStaticPaths() { const entries = await getCollection('entries'); return entries.map(entry => ({ params:{slug:entry.id}, props:{entry} })); }
const { entry } = Astro.props; const { Content } = await render(entry); const all = await getCollection('entries'); const related = all.filter(x=>entry.data.related.includes(x.id));
---
<Base title={`${entry.data.title} · Raj's Corner`}><article class={`entry-page ${entry.data.accent}`}><a class="crumb" href={`/world/${worldForType(entry.data.type)}/`}>← Back to this world</a><div class="entry-meta"><span>{entry.data.type}</span>{entry.data.location ? <a href={`/places/${placeSlug(entry.data.location)}/`}>{entry.data.location}</a> : <span>{niceDate(entry.data.date)}</span>}<span>{niceDate(entry.data.date)}</span></div><h1>{entry.data.title}</h1><p class="entry-description">{entry.data.description}</p><div class="prose"><Content /></div><div class="tags">{entry.data.tags.map(tag=><a href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></article>{related.length>0 && <section class="related"><p class="label">Connected to</p><h2>Follow a thread.</h2><div>{related.map(item=><a href={`/entry/${item.id}/`}><span>{item.data.type}</span><strong>{item.data.title}</strong> →</a>)}</div></section>}</Base>
