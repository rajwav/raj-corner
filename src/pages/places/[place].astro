---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { entries, niceDate, placeSlug } from '../../lib/universe';
import { filterVisibleEntries } from '../../lib/access-control/policy';

const placeParam = Astro.params.place;
const session = Astro.locals.session ?? null;

const rawAll = await entries();
const all = await filterVisibleEntries(rawAll, session);

// Find place matching the slug
const allPlaces = [...new Set(all.map(x => x.data.location).filter(Boolean))];
const place = allPlaces.find(p => placeSlug(String(p)) === placeParam);

if (!place) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const explicitEntries = all.filter(x => x.data.location === place);

const mentionMatches = [];
const hyphenatedPlace = place.toLowerCase().replace(/\s+/g, '-');
const placePattern = new RegExp(`@(?:${place.toLowerCase().replace(/[^a-z0-9]/g, '[\\s-]*')}|${hyphenatedPlace})\\b`, 'i');

for (const e of all) {
  if (e.data.location === place) continue;
  if (e.body && placePattern.test(e.body)) {
    mentionMatches.push(e);
  }
}
---
<Base title={`${place} · Raj's Corner`}>
  <article class="atlas-container">
    <header class="atlas-header">
      <span class="atlas-label">Coordinates // Atlas</span>
      <h1 class="atlas-title">{place}</h1>
      <p class="atlas-count">
        {explicitEntries.length + mentionMatches.length} traces found.
      </p>
    </header>

    {explicitEntries.length > 0 && (
      <section class="atlas-section">
        <h2 class="atlas-section-title">Traces found here</h2>
        <div class="atlas-grid">
          {explicitEntries.map(entry => (
            <a href={`/entry/${entry.id}/`} class="atlas-card">
              <span class="ac-date">{niceDate(entry.data.date)}</span>
              <span class="ac-type">{entry.data.type}</span>
              <h3 class="ac-title">{entry.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    {mentionMatches.length > 0 && (
      <section class="atlas-section">
        <h2 class="atlas-section-title">Mentioned in</h2>
        <div class="atlas-grid">
          {mentionMatches.map(entry => (
            <a href={`/entry/${entry.id}/`} class="atlas-card mention-card">
              <span class="ac-date">{niceDate(entry.data.date)}</span>
              <span class="ac-type">{entry.data.type}</span>
              <h3 class="ac-title">{entry.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <aside class="universe-continuation">
      <div class="continuation-actions">
        <a href="/places/" class="cont-action">Return to Atlas →</a>
        <a href="/random/" class="cont-action">Surprise Me →</a>
      </div>
    </aside>
  </article>
</Base>
