---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { entries, placeSlug } from '../../lib/universe';
import { filterVisibleEntries } from '../../lib/access-control/policy';

const session = Astro.locals.session ?? null;
const rawAll = await entries();
const all = await filterVisibleEntries(rawAll, session);

const placesData = [...new Set(all.map(x=>x.data.location).filter(Boolean))].map(name => {
  const traces = all.filter(e => e.data.location === name);
  return { name, slug: placeSlug(String(name)), traces, count: traces.length };
});

placesData.sort((a, b) => b.count - a.count || String(a.name).localeCompare(String(b.name)));
---

<Base title="The Atlas · Raj's Corner">
  <article class="atlas-container">
    <header class="atlas-header">
      <span class="atlas-label">The Atlas</span>
      <h1 class="atlas-title">Coordinates & Crossings.</h1>
      <p class="atlas-lede">Not a map of the world, but a map of where the stories point. These are the places that hold memories, trips, photographs, and quiet traces in the archive.</p>
    </header>

    <section class="atlas-catalog">
      <div class="atlas-grid">
        {placesData.map((place, index) => (
          <a href={`/places/${place.slug}/`} class="place-card">
            <div class="place-card-meta">
              <span class="place-index">No. {String(index + 1).padStart(2, '0')}</span>
              <span class="place-count">{place.count} {place.count === 1 ? 'trace' : 'traces'}</span>
            </div>
            <h2 class="place-name">{place.name}</h2>
            <div class="place-traces">
              {place.traces.slice(0, 3).map(t => (
                <span class="trace-badge">{t.data.type}</span>
              ))}
              {place.traces.length > 3 && <span class="trace-badge">+{place.traces.length - 3}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <aside class="universe-continuation">
      <div class="continuation-actions">
        <a href="/timeline/" class="cont-action">Explore time →</a>
        <a href="/people/" class="cont-action">Explore People →</a>
        <a href="/archive/" class="cont-action">Wander the Archive →</a>
        <a href="/random/" class="cont-action">Surprise Me →</a>
      </div>
    </aside>
  </article>
</Base>
