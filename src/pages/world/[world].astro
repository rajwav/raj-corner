  .person-event-link:hover .event-arrow {
    transform: translateX(3px);
    color: var(--ink, #1f1e1c);
  }

  /* ── Things I Like / Cabinet of Curiosities Styles ─────────────────────────── */
  .interests-world-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 16px 80px 16px;
  }

  .interests-header {
    margin-bottom: 50px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line, rgba(0, 0, 0, 0.12));
  }

  .interests-curator-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-light, #8a8880);
    margin-bottom: 10px;
  }

  .curator-wing-no {
    color: var(--ink, #1f1e1c);
    font-weight: 600;
  }

  .curator-sep {
    opacity: 0.4;
  }

  .interests-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 44px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink, #1f1e1c);
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .interests-lede {
    font-family: var(--serif, Georgia, serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink, #1f1e1c);
    opacity: 0.85;
    max-width: 720px;
    margin: 0 0 28px 0;
  }

  /* Gallery Directory Navigation */
  .curiosities-nav {
    margin-top: 24px;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid var(--line, rgba(0, 0, 0, 0.1));
    border-radius: 8px;
  }

  .curiosities-nav-label {
    font-family: var(--mono, monospace);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-light, #8a8880);
    margin-bottom: 12px;
  }

  .curiosities-nav-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .curiosity-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-family: var(--mono, monospace);
    font-size: 11px;
    padding: 6px 12px;
    border: 1px solid var(--line, rgba(0, 0, 0, 0.15));
    border-radius: 20px;
    color: var(--ink, #1f1e1c);
    background: var(--bg, #fcfbf9);
    transition: all 0.18s ease;
  }

  .curiosity-nav-pill:hover {
    border-color: var(--ink, #1f1e1c);
    background: var(--ink, #1f1e1c);
    color: #fff;
    transform: translateY(-1px);
  }

  .nav-room-num {
    font-size: 10px;
    opacity: 0.6;
    font-weight: 600;
  }

  .curiosity-nav-pill:hover .nav-room-num {
    opacity: 0.9;
  }

  /* Cabinet Rooms Stack */
  .curiosities-cabinet {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .curiosity-room {
    scroll-margin-top: 40px;
    padding: 36px;
    border-radius: 10px;
    border: 1px solid var(--line, rgba(0, 0, 0, 0.12));
    position: relative;
    overflow: hidden;
  }

  .room-header {
    margin-bottom: 28px;
    position: relative;
    z-index: 2;
  }

  .room-meta-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .room-num {
    font-family: var(--mono, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 3px;
    color: var(--ink, #1f1e1c);
  }

  .room-badge {
    font-family: var(--mono, monospace);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light, #8a8880);
  }

  .room-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 30px;
    font-weight: 600;
    color: var(--ink, #1f1e1c);
    margin: 4px 0 6px 0;
    letter-spacing: -0.01em;
  }

  .room-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-light, #8a8880);
    margin: 0;
    max-width: 680px;
  }

  /* Shared Card & Typography Elements */
  .car-title a,
  .book-title a,
  .game-title a,
  .sport-title a,
  .challenge-title a,
  .media-title a,
  .tech-title a,
  .space-title a,
  .run-title a,
  .gym-title a {
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
  }

  .car-title a:hover,
  .book-title a:hover,
  .game-title a:hover,
  .sport-title a:hover,
  .challenge-title a:hover,
  .media-title a:hover,
  .tech-title a:hover,
  .space-title a:hover,
  .run-title a:hover,
  .gym-title a:hover {
    opacity: 0.75;
  }

  .room-card-arrow {
    font-family: var(--mono, monospace);
    font-size: 11px;
    text-decoration: none;
    color: var(--text-light, #8a8880);
    margin-top: auto;
    padding-top: 10px;
    display: inline-block;
    transition: color 0.15s, transform 0.15s;
  }

  .room-card-arrow:hover {
    color: var(--ink, #1f1e1c);
    transform: translateX(3px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     ROOM 01: MUSIC — The Listening Room (Vinyl Shelf)
     ══════════════════════════════════════════════════════════════════════════ */
  .curiosity-room-music {
    background: #faf8f5;
    border-color: #e4ddd3;
  }

  .turntable-bench {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vinyl-crate-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 4px;
    font-family: var(--mono, monospace);
    font-size: 10px;
    color: var(--text-light, #8a8880);
    letter-spacing: 0.08em;
  }

  .music-records-shelf {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .record-row-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink, #1f1e1c);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .record-row-item:hover {
    border-color: rgba(0, 0, 0, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
  }

  .record-index {
    font-family: var(--mono, monospace);
    font-size: 12px;
    color: var(--text-light, #8a8880);
    width: 24px;
  }

  .record-thumb-frame {
    position: relative;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
  }

  .record-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    position: relative;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .record-thumb-jacket {
    width: 100%;
    height: 100%;
    background: #2a2824;
    color: #e5ded3;
    border-radius: 4px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .jacket-corner-tag {
    font-family: var(--mono, monospace);
    font-size: 8px;
    opacity: 0.6;
  }

  .jacket-short-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 10px;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .record-thumb-vinyl {
    position: absolute;
    top: 3px;
    left: 12px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #181715;
    z-index: 1;
    transition: transform 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .record-row-item:hover .record-thumb-vinyl {
    transform: translateX(14px) rotate(180deg);
  }

  .record-vinyl-groove {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.15);
  }

  .record-vinyl-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #d4a373;
    border: 1px solid rgba(0, 0, 0, 0.4);
  }

  .record-main-info {
    flex: 1;
    min-width: 0;
  }

  .record-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 2px 0;
    color: var(--ink, #1f1e1c);
  }

  .record-artist {
    font-family: var(--mono, monospace);
    font-size: 11px;
    color: var(--text-light, #8a8880);
    display: block;
    margin-bottom: 4px;
  }

  .record-desc {
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--ink, #1f1e1c);
    opacity: 0.8;
    margin: 0;
  }

  .record-status-strip {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .analogue-wave-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
    opacity: 0.4;
  }

  .record-row-item:hover .analogue-wave-bars {
    opacity: 0.9;
  }

  .aw-bar {
    width: 3px;
    background: var(--ink, #1f1e1c);
    border-radius: 1px;
    transition: height 0.2s ease;
  }
  .aw-bar.b-1 { height: 6px; }
  .aw-bar.b-2 { height: 14px; }
  .aw-bar.b-3 { height: 10px; }
  .aw-bar.b-4 { height: 8px; }

  .record-row-item:hover .aw-bar.b-1 { height: 12px; }
  .record-row-item:hover .aw-bar.b-2 { height: 8px; }
  .record-row-item:hover .aw-bar.b-3 { height: 15px; }
  .record-row-item:hover .aw-bar.b-4 { height: 11px; }

  .record-arrow {
    font-family: var(--mono, monospace);
    font-size: 11px;
    color: var(--text-light, #8a8880);
  }
  .record-row-item:hover .record-arrow {
    color: var(--ink, #1f1e1c);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     ROOM 02: CARS — The Private Garage at Night
     ══════════════════════════════════════════════════════════════════════════ */
  .curiosity-room-cars {
    background: #14161a;
    border-color: #272a30;
    color: #e2e4e8;
  }

  .curiosity-room-cars .room-num {
    background: rgba(255, 255, 255, 0.1);
    color: #e2e4e8;
  }
  .curiosity-room-cars .room-title {
    color: #f4f5f7;
  }
  .curiosity-room-cars .room-desc {
    color: #9da3af;
  }

  .garage-overhead-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .garage-bay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 22px;
    position: relative;
    z-index: 2;
  }

  .garage-machine-card {
    background: #1c1f24;
    border: 1px solid #2d3139;
    border-radius: 8px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .garage-machine-card:hover {
    border-color: #4a5160;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .machine-bay-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .machine-make {
    font-family: var(--mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8f97a5;
  }

  .garage-machine-card .car-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 22px;
    font-weight: 600;
    color: #f4f5f7;
    margin: 2px 0 0 0;
  }

  .machine-bay-tag {
    font-family: var(--mono, monospace);
    font-size: 9px;
    padding: 3px 6px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    color: #adb5c4;
    letter-spacing: 0.08em;
  }

  .machine-blueprint-viewport {
    height: 100px;
    background: #16181d;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 10px 0 16px 0;
  }

  .blueprint-grid-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .car-silhouette-svg {
    width: 86%;
    height: auto;
    color: #9aa2b1;
    position: relative;
    z-index: 2;
    transition: color 0.2s, transform 0.2s;
  }

  .garage-machine-card:hover .car-silhouette-svg {
    color: #e2e8f0;
    transform: scale(1.02);
  }

  /* Stamped Chassis Plate */
  .chassis-spec-plate {
    background: linear-gradient(135deg, #24272e, #1e2025);
    border: 1px solid #383e4a;
    border-radius: 4px;
    padding: 12px 14px;
    position: relative;
    margin: 6px 0 14px 0;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .rivet {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #505866;
    border: 1px solid #14161a;
  }
  .rivet.r-tl { top: 4px; left: 4px; }
  .rivet.r-tr { top: 4px; right: 4px; }
  .rivet.r-bl { bottom: 4px; left: 4px; }
  .rivet.r-br { bottom: 4px; right: 4px; }

  .plate-top-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono, monospace);
    font-size: 9px;
    color: #8c95a6;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .plate-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .plate-field {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono, monospace);
    font-size: 10px;
  }

  .field-k {
    color: #8c95a6;
  }
  .field-v {
    color: #e2e8f0;
    font-weight: 500;
  }

  .machine-desc {
    font-size: 13px;
    line-height: 1.5;
    color: #b0b7c4;
    margin: 4px 0 16px 0;
  }

  .machine-card-footer {
    margin-top: auto;
    padding-top: 8px;
  }

  .garage-inspect-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    text-decoration: none;
    color: #9aa2b1;
    transition: color 0.15s, transform 0.15s;
  }

  .garage-inspect-btn:hover {
    color: #f4f5f7;
    transform: translateX(3px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     ROOM 03: SPACE — The Personal Observatory
     ══════════════════════════════════════════════════════════════════════════ */
  .curiosity-room-space {
    background: #07090e;
    border-color: #1a202c;
    color: #e2e8f0;
  }

  .curiosity-room-space .room-num {
    background: rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
  }
  .curiosity-room-space .room-title {
    color: #f8fafc;
  }
  .curiosity-room-space .room-desc {
    color: #94a3b8;
  }

  .starfield-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stars-deep {
    background-image: 
      radial-gradient(1px 1px at 20px 30px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 80px 120px, rgba(255,255,255,0.8), rgba(0,0,0,0)),
      radial-gradient(1px 1px at 150px 70px, rgba(255,255,255,0.6), rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 240px 180px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 320px 90px, rgba(255,255,255,0.7), rgba(0,0,0,0)),
      radial-gradient(1px 1px at 450px 220px, rgba(255,255,255,0.6), rgba(0,0,0,0));
    background-size: 500px 300px;
    opacity: 0.5;
  }

  .observatory-notebook-intro {
    position: relative;
    padding: 24px 28px;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    margin-bottom: 28px;
  }

  .reticle-corner {
    position: absolute;
    font-family: var(--mono, monospace);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1;
  }
  .reticle-corner.tl { top: 6px; left: 8px; }
  .reticle-corner.tr { top: 6px; right: 8px; }
  .reticle-corner.bl { bottom: 6px; left: 8px; }
  .reticle-corner.br { bottom: 6px; right: 8px; }

  .observatory-coordinates {
    display: flex;
    gap: 16px;
    font-family: var(--mono, monospace);
    font-size: 9px;
    color: #64748b;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .curiosity-room-space .space-quote-text {
    font-family: var(--serif, Georgia, serif);
    font-size: 16px;
    font-style: italic;
    line-height: 1.6;
    color: #e2e8f0;
    margin: 0;
  }

  .space-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .observatory-concept-card {
    background: #0f141e;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .observatory-concept-card:hover {
    border-color: #38bdf8;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.08);
    transform: translateY(-2px);
  }

  .concept-celestial-reticle {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.05) 0%, transparent 70%);
  }

  .celestial-orbit-svg {
    width: 100px;
    height: 100px;
  }

  .concept-meta-strip {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono, monospace);
    font-size: 9px;
    color: #64748b;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .observatory-concept-card .space-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 20px;
    font-weight: 600;
    color: #f8fafc;
    margin: 0 0 8px 0;
  }

  .observatory-concept-card .space-desc {
    font-size: 13px;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0 0 16px 0;
  }

  .observatory-deep-link {
    font-family: var(--mono, monospace);
    font-size: 11px;
    text-decoration: none;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s, transform 0.15s;
  }

  .observatory-concept-card:hover .observatory-deep-link {
    color: #38bdf8;
    transform: translateX(3px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     ROOM 04: BOOKS — The Personal Study
     ══════════════════════════════════════════════════════════════════════════ */
  .curiosity-room-books {
    background: #faf7f2;
    border-color: #e5ded3;
  }

  .study-shelf-header {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 4px;
    font-family: var(--mono, monospace);
    font-size: 10px;
    color: var(--text-light, #8a8880);
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 22px;
  }

  .study-volume-card {
    background: #fff;
    border: 1px solid #e2dacd;
    border-radius: 6px;
    padding: 24px;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.03);
