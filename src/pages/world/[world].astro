---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import AccessGate from '../../components/AccessGate.astro';
import { entries, worlds, entryWorld, niceDate, placeSlug } from '../../lib/universe';
import { evaluateAccess, filterVisibleEntries, PUBLIC_WORLD_SLUGS } from '../../lib/access-control/policy';
import { buildLifeSections } from '../../lib/people';
import {
  INTEREST_CATEGORIES,
  buildInterestRooms,
  calculateRunningPersonalBests,
  calculateGymRecords
} from '../../lib/interests';

const { world } = Astro.params;
const definition = worlds.find(([slug])=>slug===world);
if (!definition) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const session = Astro.locals.session ?? null;
const pageAccess = await evaluateAccess({ path: `/world/${world}`, world }, session);

if (!pageAccess.allowed) {
  Astro.response.status = pageAccess.reason === 'unauthenticated' ? 401 : 403;
}

const allEntries = await entries();
const rawFound = allEntries.filter(entry => entryWorld(entry) === world);

// For public world landing pages, show ALL entries in the listing so visitors
// can discover what exists. Each entry is evaluated individually — private ones
// show a discovery card (title + lock) rather than full content.
// For non-public worlds, only show what the session is authorized to see.
const isPublicWorld = PUBLIC_WORLD_SLUGS.has(world ?? '');
const visibleEntries = pageAccess.allowed ? await filterVisibleEntries(rawFound, session) : [];
const visibleEntryIds = new Set(visibleEntries.map(e => e.id));

// `found` = entries shown in the listing; `visibleEntryIds` tells the template
// which ones can render full content vs a locked discovery card.
const found = isPublicWorld && pageAccess.allowed ? rawFound : visibleEntries;


// Sort for Travel
const sortedEntries = found.slice().sort((a, b) => {
  if (!a.data.date) return 1;
  if (!b.data.date) return -1;
  return b.data.date.getTime() - a.data.date.getTime();
});

// Life world sections: Chronology (years), People (independent of dates), Timeless
const lifeSections = world === 'life' ? buildLifeSections(found, allEntries) : null;


// Groups for Making
const mkCurrent = found.filter(e => ['now', 'building', 'learning'].includes((e.data as any).status));
const mkExperiments = found.filter(e => e.data.type === 'experiment' && !mkCurrent.includes(e));
const mkIdeas = found.filter(e => (e.data.type === 'idea' || e.data.type === 'note' || e.data.type === 'thought' || e.data.type === 'goal') && !mkCurrent.includes(e));
const mkOther = found.filter(e => !mkCurrent.includes(e) && !mkExperiments.includes(e) && !mkIdeas.includes(e));

// Groups for Interests (Cabinet of Curiosities)
const interestRooms = world === 'interests' ? buildInterestRooms(found) : [];
const runEntries = world === 'interests' ? found.filter(e => e.data.type === 'run' || (e.data as any).subcategory === 'running' || (e.data as any).distance) : [];
const gymEntries = world === 'interests' ? found.filter(e => e.data.type === 'workout' || (e.data as any).subcategory === 'gym' || (e.data as any).exercises) : [];
const runningPBs = world === 'interests' ? calculateRunningPersonalBests(runEntries) : null;
const gymRecords = world === 'interests' ? calculateGymRecords(gymEntries) : [];
---
<Base title={pageAccess.allowed ? `${definition[1]} · Raj's Corner` : `${definition[1]} (Protected) · Raj's Corner`}>
  {!pageAccess.allowed ? (
    <AccessGate
      evaluation={pageAccess}
      resourcePath={`/world/${world}`}
      worldSlug={world}
      resourceTitle={definition[1]}
      session={session}
    />
  ) : world === 'travel' ? (
    <article class="travel-world-container">
      <header class="travel-header">
        <span class="travel-label">A wing in the archive</span>
        <h1 class="travel-title">{definition[1]}</h1>
        <p class="travel-lede">{definition[2]}</p>
        <p class="travel-count">{found.length} {found.length === 1 ? 'journey' : 'journeys'} recorded.</p>
      </header>
      
      <section class="travel-journeys">
        {sortedEntries.map((entry, idx) => {
          const isAccessible = visibleEntryIds.has(entry.id);
          const isAbsPrivate = entry.data.visibility === 'absolute_private';
          if (!isAccessible) {
            return (
              <article class={`travel-journey locked-entry ${idx === 0 ? 'featured' : ''}`}>
                <a href={`/entry/${entry.id}/`} class="locked-entry-link" aria-label={`Private entry: ${entry.data.title}`}>
                  <div class="locked-entry-inner">
                    <span class="locked-icon" aria-hidden="true">🔒</span>
                    <span class="locked-title">{entry.data.title}</span>
                    <span class="locked-badge">{isAbsPrivate ? 'Owner only' : 'Private'}</span>
                  </div>
                </a>
              </article>
            );
          }
          return (
            <article class={`travel-journey ${entry.data.cover ? 'has-cover' : ''} ${idx === 0 ? 'featured' : ''}`}>
              {entry.data.cover && (
                <a href={`/entry/${entry.id}/`} class="journey-cover-link">
                  <figure class="journey-cover">
                    <img src={entry.data.cover} alt={entry.data.title} loading="lazy" />
                  </figure>
                </a>
              )}
              <div class="journey-content">
                <div class="journey-meta">
                  {entry.data.date && <span class="j-date">{niceDate(entry.data.date)}</span>}
                  {entry.data.location && (
                    <a href={`/places/${placeSlug(entry.data.location)}/`} class="j-location">
                      {entry.data.location}
                    </a>
                  )}
                  <span class="j-type">{entry.data.type}</span>
                </div>
                <a href={`/entry/${entry.id}/`} class="journey-title-link">
                  <h2 class="journey-title">{entry.data.title}</h2>
                </a>
                {entry.data.description && <p class="journey-desc">{entry.data.description}</p>}
                <a href={`/entry/${entry.id}/`} class="journey-arrow">Read field notes →</a>
              </div>
            </article>
          );
        })}
      </section>
      
      <footer class="travel-footer">
        <p class="travel-label">Keep wandering</p>
        <div class="travel-links">
          <a href="/places/">Open the Atlas →</a>
          <a href="/timeline/">View Timeline →</a>
          <a href="/archive/">Search the Archive →</a>
        </div>
      </footer>
    </article>
  ) : world === 'life' && lifeSections ? (
    <article class="life-world-container">
      <header class="life-header">
        <span class="life-label">A life in fragments</span>
        <h1 class="life-title">Life</h1>
        <p class="life-lede">Some things are worth remembering. Some are worth writing down. This is where they stay.</p>
        <p class="life-count">{found.length} {found.length === 1 ? 'fragment' : 'fragments'} kept so far.</p>
      </header>

      {/* 1. CHRONOLOGY: 2026, 2025, ... (people are NOT assigned to years) */}
      <section class="life-chronology">
        {lifeSections.years.map(({ year, entries: items }) => (
          <div class="life-era-block">
            <h2 class="life-era-marker">{year}</h2>
            <div class="life-fragments">
              {items.map(entry => {
                const isAccessible = visibleEntryIds.has(entry.id);
                const isAbsPrivate = entry.data.visibility === 'absolute_private';

                if (!isAccessible) {
                  return (
                    <article class="life-fragment frag-locked">
                      <a href={`/entry/${entry.id}/`} class="locked-entry-link" aria-label={`Private entry: ${entry.data.title}`}>
                        <div class="locked-entry-inner">
                          <span class="locked-icon" aria-hidden="true">🔒</span>
                          <span class="locked-title">{entry.data.title}</span>
                          <span class="locked-badge">{isAbsPrivate ? 'Owner only' : 'Private'}</span>
                        </div>
                      </a>
                    </article>
                  );
                }

                const isPhoto = entry.data.type === 'photo';
                const isMilestone = entry.data.type === 'milestone';
                const isMemory = entry.data.type === 'memory';
                const isThought = entry.data.type === 'note' || entry.data.type === 'idea';
                
                let fragType = 'ordinary';
                if (isPhoto) fragType = 'photo';
                else if (isMilestone) fragType = 'milestone';
                else if (isMemory) fragType = 'memory';
                else if (isThought) fragType = 'thought';

                return (
                  <article class={`life-fragment frag-${fragType}`}>
                    {isPhoto && entry.data.cover ? (
                      <div class="frag-photo-wrapper">
                        <a href={`/entry/${entry.id}/`} class="frag-photo-link">
                          <img src={entry.data.cover} alt={entry.data.title} loading="lazy" />
                        </a>
                        <div class="frag-photo-caption">
                          <span>{entry.data.title}</span>
                          {entry.data.date && <span>{niceDate(entry.data.date)}</span>}
                        </div>
                      </div>
                    ) : isMilestone ? (
                      <a href={`/entry/${entry.id}/`} class="frag-milestone-link">
                        <span class="m-date">{entry.data.date ? niceDate(entry.data.date) : ''}</span>
                        <h3 class="m-title">{entry.data.title}</h3>
                        {entry.data.description && <p class="m-desc">{entry.data.description}</p>}
                      </a>
                    ) : (
                      <div class="frag-content-wrapper">
                        <div class="frag-meta">
                          {entry.data.date && <span class="f-date">{niceDate(entry.data.date)}</span>}
                          <span class="f-type">{entry.data.type}</span>
                          {entry.data.location && (
                            <a href={`/places/${placeSlug(entry.data.location)}/`} class="f-location">
                              {entry.data.location}
                            </a>
                          )}
                        </div>
                        <a href={`/entry/${entry.id}/`} class="frag-title-link">
                          <h3 class="f-title">{entry.data.title}</h3>
                        </a>
                        {entry.data.description && <p class="f-desc">{entry.data.description}</p>}
                        
                        {isMemory && entry.data.cover && (
                          <a href={`/entry/${entry.id}/`} class="frag-memory-photo">
                            <img src={entry.data.cover} alt={entry.data.title} loading="lazy" />
                          </a>
                        )}
                        
                        <a href={`/entry/${entry.id}/`} class="frag-read-more">
                          Read fragment →
                        </a>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </section>

      {/* 2. PEOPLE: Separate section independent of years */}
      <section class="life-era-block life-people-block">
        <h2 class="life-era-marker">People</h2>
        <div class="life-people-list">
          {lifeSections.people.map(({ person, events }) => {
            const isPersonAccessible = visibleEntryIds.has(person.id);
            const isPersonAbsPrivate = person.data.visibility === 'absolute_private';

            return (
              <div class="person-node">
                <div class="person-main">
                  {!isPersonAccessible ? (
                    <div class="person-locked-card">
                      <a href={`/entry/${person.id}/`} class="locked-entry-link" aria-label={`Private person: ${person.data.title}`}>
                        <div class="locked-entry-inner">
                          <span class="locked-icon" aria-hidden="true">🔒</span>
                          <span class="locked-title">{person.data.title}</span>
                          <span class="locked-badge">{isPersonAbsPrivate ? 'Owner only' : 'Private'}</span>
                        </div>
                      </a>
                    </div>
                  ) : (
                    <div class="person-card">
                      <a href={`/entry/${person.id}/`} class="person-name-link">
                        <h3 class="person-name">{person.data.title}</h3>
                      </a>
                      {person.data.location && (
                        <span class="person-location">{person.data.location}</span>
                      )}
                      <a href={`/entry/${person.id}/`} class="person-arrow" aria-label={`View ${person.data.title}`}>
                        Enter profile →
                      </a>
                    </div>
                  )}
                </div>

                {events.length > 0 && (
                  <div class="person-events-branch">
                    <ul class="person-events-list">
                      {events.map(event => {
                        const isEventAccessible = visibleEntryIds.has(event.id);
                        const isEventAbsPrivate = event.data.visibility === 'absolute_private';

                        return (
                          <li class="person-event-item">
                            {!isEventAccessible ? (
                              <a href={`/entry/${event.id}/`} class="locked-entry-link" aria-label={`Private event: ${event.data.title}`}>
                                <div class="locked-entry-inner">
                                  <span class="locked-icon" aria-hidden="true">🔒</span>
                                  <span class="locked-title">{event.data.title}</span>
                                  <span class="locked-badge">{isEventAbsPrivate ? 'Owner only' : 'Private'}</span>
                                </div>
                              </a>
                            ) : (
                              <a href={`/entry/${event.id}/`} class="person-event-link">
                                <span class="event-title">{event.data.title}</span>
                                <span class="event-arrow">→</span>
                              </a>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      {/* 3. TIMELESS: Genuinely undated life entries (excluding people) */}
      {lifeSections.timeless.length > 0 && (
        <section class="life-era-block life-timeless-block">
          <h2 class="life-era-marker">Timeless</h2>
          <div class="life-fragments">
            {lifeSections.timeless.map(entry => {
              const isAccessible = visibleEntryIds.has(entry.id);
              const isAbsPrivate = entry.data.visibility === 'absolute_private';

              if (!isAccessible) {
                return (
                  <article class="life-fragment frag-locked">
                    <a href={`/entry/${entry.id}/`} class="locked-entry-link" aria-label={`Private entry: ${entry.data.title}`}>
                      <div class="locked-entry-inner">
                        <span class="locked-icon" aria-hidden="true">🔒</span>
                        <span class="locked-title">{entry.data.title}</span>
                        <span class="locked-badge">{isAbsPrivate ? 'Owner only' : 'Private'}</span>
                      </div>
                    </a>
                  </article>
                );
              }

              return (
                <article class="life-fragment frag-ordinary">
                  <div class="frag-content-wrapper">
                    <div class="frag-meta">
                      <span class="f-type">{entry.data.type}</span>
                      {entry.data.location && (
                        <a href={`/places/${placeSlug(entry.data.location)}/`} class="f-location">
                          {entry.data.location}
                        </a>
                      )}
                    </div>
                    <a href={`/entry/${entry.id}/`} class="frag-title-link">
                      <h3 class="f-title">{entry.data.title}</h3>
                    </a>
                    {entry.data.description && <p class="f-desc">{entry.data.description}</p>}
                    <a href={`/entry/${entry.id}/`} class="frag-read-more">Read fragment →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <footer class="life-footer">
        <p class="life-footer-label">Keep looking around</p>
        <div class="life-links">
          <a href="/people/">People</a>
          <a href="/timeline/">Timeline</a>
          <a href="/places/">Atlas</a>
          <a href="/currently/">Currently</a>
          <a href="/world/travel/">Travel</a>
          <a href="/archive/">Archive</a>
          <a href="/random/">Surprise Me</a>
        </div>
      </footer>
    </article>
  ) : world === 'interests' ? (
    <article class="interests-world-container">
      <header class="interests-header">
        <div class="interests-curator-badge">
          <span class="curator-wing-no">WING IV</span>
          <span class="curator-sep">·</span>
          <span class="interests-label">A Cabinet of Curiosities</span>
        </div>
        <h1 class="interests-title">Things I Like</h1>
        <p class="interests-lede">These are some of the things that fascinate me, entertain me, make me curious, or become temporary obsessions.</p>
        
        <nav class="curiosities-nav" aria-label="Curiosity rooms directory">
          <div class="curiosities-nav-label">GALLERY DIRECTORY</div>
          <div class="curiosities-nav-pills">
            {INTEREST_CATEGORIES.map((cat, idx) => (
              <a href={`#${cat.id}`} class="curiosity-nav-pill">
                <span class="nav-room-num">{String(idx + 1).padStart(2, '0')}</span>
                <span class="nav-room-name">{cat.name}</span>
              </a>
            ))}
          </div>
        </nav>
      </header>

      <div class="curiosities-cabinet">
        {interestRooms.map(room => {
          const { category, entries: rEntries } = room;
          const catId = category.id;
          const roomIndex = INTEREST_CATEGORIES.findIndex(c => c.id === catId) + 1;
          const roomNumStr = String(roomIndex).padStart(2, '0');

          return (
            <section id={catId} class={`curiosity-room curiosity-room-${catId}`}>
              <div class="room-header">
                <div class="room-meta-tag">
                  <span class="room-num">ROOM {roomNumStr}</span>
                  <span class="room-badge">{category.badge}</span>
                </div>
                <h2 class="room-title">{category.name}</h2>
                <p class="room-desc">{category.shortDesc}</p>
              </div>

              {/* ROOM 1: MUSIC — Private Listening Room */}
              {catId === 'music' && (
                <div class="music-listening-room">
                  <div class="turntable-bench">
                    <div class="vinyl-crate-header">
                      <span class="vinyl-crate-tag">VINYL RECORD SHELF · 33⅓ RPM</span>
                      <span class="vinyl-crate-count">{rEntries.length} TITLES FILED</span>
                    </div>
                    <div class="music-records-shelf">
                      {rEntries.map((entry, index) => {
                        const numStr = String(index + 1).padStart(2, '0');
                        const isAccessible = visibleEntryIds.has(entry.id);
                        const isAbsPrivate = entry.data.visibility === 'absolute_private';
                        if (!isAccessible) {
                          return (
                            <a href={`/entry/${entry.id}/`} class="record-row-item locked-entry-link" aria-label={`Private: ${entry.data.title}`}>
                              <span class="record-index">{numStr}</span>
                              <div class="record-thumb-frame">
                                <div class="record-thumb-vinyl" aria-hidden="true"><div class="record-vinyl-groove"></div></div>
                              </div>
                              <div class="record-main-info">
                                <span class="record-title">{entry.data.title}</span>
                                <span class="locked-badge">{isAbsPrivate ? 'Owner only' : '🔒 Private'}</span>
                              </div>
                            </a>
                          );
                        }
                        const artistName = (entry.data as any).artist || 'Curated Sound';
                        return (
                          <a href={`/entry/${entry.id}/`} class="record-row-item">
                            <span class="record-index">{numStr}</span>
                            <div class="record-thumb-frame">
                              {entry.data.cover ? (
                                <img src={entry.data.cover} alt={entry.data.title} class="record-thumb-img" loading="lazy" />
                              ) : (
                                <div class="record-thumb-jacket">
                                  <span class="jacket-corner-tag">EP</span>
                                  <span class="jacket-short-title">{entry.data.title.substring(0, 14)}</span>
                                </div>
                              )}
                              <div class="record-thumb-vinyl" aria-hidden="true">
                                <div class="record-vinyl-groove"></div>
                                <div class="record-vinyl-center"></div>
                              </div>
                            </div>
                            <div class="record-main-info">
                              <span class="record-title">{entry.data.title}</span>
                              <span class="record-artist">{artistName}</span>
                              {entry.data.description && <p class="record-desc">{entry.data.description}</p>}
                            </div>
                            <div class="record-status-strip">
                              <div class="analogue-wave-bars" aria-hidden="true">
                                <span class="aw-bar b-1"></span>
                                <span class="aw-bar b-2"></span>
                                <span class="aw-bar b-3"></span>
                                <span class="aw-bar b-4"></span>
                              </div>
                              <span class="record-arrow">Listen →</span>
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              )}

              {/* ROOM 2: CARS — Quiet Private Garage at Night */}
              {catId === 'cars' && (
                <div class="garage-bay-room">
                  <div class="garage-overhead-beam" aria-hidden="true"></div>
                  <div class="garage-bay-grid">
                    {rEntries.map(entry => {
                      const isAccessible = visibleEntryIds.has(entry.id);
                      const isAbsPrivate = entry.data.visibility === 'absolute_private';
                      if (!isAccessible) {
                        return (
                          <div class="car-card locked-entry">
                            <a href={`/entry/${entry.id}/`} class="locked-entry-link">
                              <div class="locked-entry-inner">
                                <span class="locked-icon" aria-hidden="true">🔒</span>
                                <span class="locked-title">{entry.data.title}</span>
                                <span class="locked-badge">{isAbsPrivate ? 'Owner only' : 'Private'}</span>
                              </div>
                            </a>
                          </div>
                        );
                      }
                      const specs = (entry.data as any).specs || {};
                      const make = (entry.data as any).make || 'MACHINE';
                      const model = (entry.data as any).model || entry.data.title;
                      const is911 = entry.id.includes('911') || entry.data.title.includes('911');
                      const isGhost = entry.id.includes('ghost') || entry.data.title.includes('Ghost');
                      const isM5 = entry.id.includes('m5') || entry.data.title.includes('M5');

                      return (
                        <article class="garage-machine-card">
                          <div class="machine-bay-header">
                            <div class="machine-identity">
                              <span class="machine-make">{make}</span>
                              <h3 class="car-title">
                                <a href={`/entry/${entry.id}/`}>{entry.data.title}</a>
                              </h3>
                            </div>
                            <span class="machine-bay-tag">BAY · {model.toUpperCase()}</span>
                          </div>

                          <div class="machine-blueprint-viewport">
                            <div class="blueprint-grid-lines" aria-hidden="true"></div>
                            {is911 && (
                              <svg class="car-silhouette-svg porsche-svg" viewBox="0 0 420 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Porsche 911 Silhouette">
                                <path d="M 30,85 C 40,85 55,85 70,85 C 80,68 95,60 115,60 C 135,60 150,68 158,85 C 220,85 270,85 285,85 C 295,68 310,60 330,60 C 350,60 365,68 375,85 C 395,85 405,82 408,75 C 410,65 400,55 385,50 C 350,42 320,38 275,25 C 235,14 185,14 140,28 C 95,42 60,55 45,65 C 32,74 25,82 30,85 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M 140,28 C 175,22 225,22 265,30 C 275,32 295,40 310,50 L 220,50 C 175,50 148,45 140,28 Z" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6" />
                                <circle cx="115" cy="85" r="22" stroke="currentColor" stroke-width="1.8" />
                                <circle cx="115" cy="85" r="10" stroke="currentColor" stroke-width="1.2" />
                                <circle cx="330" cy="85" r="22" stroke="currentColor" stroke-width="1.8" />
                                <circle cx="330" cy="85" r="10" stroke="currentColor" stroke-width="1.2" />
                                <line x1="10" y1="107" x2="410" y2="107" stroke="currentColor" stroke-width="0.8" opacity="0.4" />
                              </svg>
                            )}
                            {isGhost && (
                              <svg class="car-silhouette-svg ghost-svg" viewBox="0 0 420 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Rolls-Royce Ghost Silhouette">
                                <path d="M 25,85 C 35,85 55,85 70,85 C 80,68 95,60 115,60 C 135,60 150,68 160,85 C 220,85 275,85 295,85 C 305,68 320,60 340,60 C 360,60 375,68 385,85 C 400,85 410,80 412,70 C 412,50 405,45 370,42 C 340,40 310,32 280,26 C 240,20 170,20 110,24 C 65,27 45,35 35,45 C 28,52 24,70 25,85 Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M 120,26 L 120,50 L 260,50 L 275,30" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6" />
                                <circle cx="115" cy="85" r="22" stroke="currentColor" stroke-width="1.8" />
