---
import Base from '../../layouts/Base.astro'; import { entries, niceDate, worldForType } from '../../lib/universe';
const all = await entries(); const types = [...new Set(all.map(e=>e.data.type))].sort(); const years = [...new Set(all.map(e=>e.data.date?.getFullYear()).filter(Boolean))].sort().reverse(); const tags = [...new Set(all.flatMap(e=>e.data.tags))].sort();
---
<Base title="The archive · Raj's Corner"><section class="page-intro"><p class="label">Everything, in one place</p><h1>The archive.</h1><p class="lede">A library of trips, memories, photographs, interests and fragments. Filter it if you know what you’re seeking—or leave everything open and wander.</p></section><section class="archive"><div class="archive-controls"><label>Type <select id="type-filter"><option value="">Everything</option>{types.map(type=><option value={type}>{type}</option>)}</select></label><label>Year <select id="year-filter"><option value="">Any year</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><label>Tag <select id="tag-filter"><option value="">Any tag</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label><button id="clear-filter">Clear</button></div><p id="archive-count" class="label">{all.length} entries in the archive</p><div class="archive-list">{all.map(entry => <a href={`/entry/${entry.id}/`} data-type={entry.data.type} data-year={entry.data.date?.getFullYear()} data-tags={entry.data.tags.join('|')}><span>{entry.data.type}</span><h2>{entry.data.title}</h2><p>{entry.data.location ?? niceDate(entry.data.date)} · {worldForType(entry.data.type)}</p><b>↗</b></a>)}</div></section><script is:inline>
const params=new URLSearchParams(location.search), inputs={type:document.querySelector('#type-filter'),year:document.querySelector('#year-filter'),tag:document.querySelector('#tag-filter')}; for(const key in inputs){if(params.get(key)) inputs[key].value=params.get(key)}; const rows=[...document.querySelectorAll('.archive-list a')], count=document.querySelector('#archive-count'); function filter(){let visible=0;rows.forEach(row=>{const show=(!inputs.type.value||row.dataset.type===inputs.type.value)&&(!inputs.year.value||row.dataset.year===inputs.year.value)&&(!inputs.tag.value||row.dataset.tags.split('|').includes(inputs.tag.value));row.hidden=!show;if(show)visible++});count.textContent=`${visible} ${visible===1?'entry':'entries'} in the archive`};Object.values(inputs).forEach(input=>input.addEventListener('change',filter));document.querySelector('#clear-filter').addEventListener('click',()=>{Object.values(inputs).forEach(input=>input.value='');history.replaceState({},'',location.pathname);filter()});filter();
</script></Base>
