---
export const prerender = false;

import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { entries, worlds } from '../lib/universe';

const session = Astro.locals.session ?? null;
const rawAll = await entries();
// Discovery is deliberately limited to title-level metadata. EntryList decides
// whether a visitor can open each item and never emits private fields.
const recent = rawAll.slice(0, 4);

// Filter primary worlds for the museum wings
const primaryWorlds = worlds.filter(([slug]) => !['archive', 'me'].includes(slug));
---

<Base>
  <section class="hero universe-hero">
    <p class="label">Coordinates: Earth</p>
    <h1>
      This is not my website.<br /><em>It’s my world.</em>
    </h1>
    <p class="lede">
      A growing archive of places I’ve been, things I want, songs that stayed,
      small memories, large questions, and whatever else earns a place here.
    </p>
    <div class="hero-actions">
      <p class="quiet">Start anywhere. Follow the threads.</p>
    </div>
  </section>

  <section class="museum-wings">
    <div class="wings-intro">
      <p class="label">The Wings</p>
      <h2>
        There are many doors.<br />None is the right one.
      </h2>
    </div>
    
    <div class="wings-grid">
      {
        primaryWorlds.map(([slug, title, desc, accent]) => (
          <a href={`/world/${slug}/`} class={`wing-door ${accent}`}>
            <div class="wing-content">
              <h3>{title}</h3>
              <p>{desc}</p>
            </div>
            <div class="wing-meta">Enter wing →</div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="cross-dimensions">
    <p class="label">Other Dimensions</p>
    <div class="dimension-list">
      <a href="/timeline/" class="dimension">
        <h4>The Timeline</h4>
        <p>A chronological record of days.</p>
      </a>
      <a href="/places/" class="dimension">
        <h4>The Atlas</h4>
        <p>A map of where the stories point.</p>
      </a>
      <a href="/currently/" class="dimension">
        <h4>Currently</h4>
        <p>A living snapshot of right now.</p>
      </a>
    </div>
  </section>

  <section class="recent-artifacts">
    <EntryList entries={recent} heading="Recently cataloged artifacts" />
  </section>
</Base>
