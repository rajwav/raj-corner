# ==============================================================================
# Raj's Corner Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE URL & HOSTING
# ------------------------------------------------------------------------------
# The canonical public URL of the website.
# - Local development: http://localhost:4321
# - Production (Vercel): https://raj-corner.vercel.app
PUBLIC_SITE_URL=http://localhost:4321

# ------------------------------------------------------------------------------
# 2. SESSION SECURITY
# ------------------------------------------------------------------------------
# 32+ byte cryptographic secret for HMAC signing of visitor & owner session tokens.
# Generate in terminal: openssl rand -base64 32
# Required in production.
AUTH_SECRET=

# ------------------------------------------------------------------------------
# 3. OWNER IDENTITY
# ------------------------------------------------------------------------------
# The Google account email of the site owner.
# Any verified Google login matching this email is automatically granted owner role.
# Required in production.
OWNER_EMAIL=ppdpitambar574@gmail.com

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (From Google Cloud Console)
# ------------------------------------------------------------------------------
# Authorized Redirect URIs in Google Cloud Console must include:
#   http://localhost:4321/api/auth/callback/google
#   https://raj-corner.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. LEGACY OWNER PASSPHRASE (Optional)
# ------------------------------------------------------------------------------
# Passphrase for the fallback password form on the /login owner tab.
# Not required for Google OAuth owner authentication.
OWNER_SECRET=
